*.key
*.p12
*.pfx
*.jks
*.keystore
*.db
*.sqlite
*.sqlite3
.env
.env.*
key.properties

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/
